    },
    {
      "id": "worry-walk",
      "kind": "move",
      "title": "Suba a rua com Tenebris",
      "x": 2690,
      "y": 850,
      "range": 70,
      "speed": 138,
      "lines": [
        {
          "speaker": "Tenebris",
          "text": "Aconteceu alguma coisa ontem?"
        },
        {
          "speaker": "Yuuki",
          "text": "Não."
        },
        {
          "speaker": "Tenebris",
          "text": "Tá."
        },
        {
          "speaker": "Yuuki",
          "text": "O que foi?"
        },
        {
          "speaker": "Tenebris",
          "text": "Nada."
        },
        {
          "speaker": "Yuuki",
          "text": "Tenebris."
        },
        {
          "speaker": "Tenebris",
          "text": "Você falou que não aconteceu nada."
        },
        {
          "speaker": "Yuuki",
          "text": "Então por que perguntou?"
        },
        {
          "speaker": "Tenebris",
          "text": "Porque você faz isso quando tá preocupada."
        },
        {
          "speaker": "Tenebris",
          "text": "Isso."
        },
        {
          "speaker": "Yuuki",
          "text": "Eu só estava ajeitando."
        },
        {
          "speaker": "Tenebris",
          "text": "Faz dez minutos?"
        },
        {
          "speaker": "Yuuki",
          "text": "Não fazem dez minutos."
        },
        {
          "speaker": "Tenebris",
          "text": "Sete?"
        },
        {
          "speaker": "Yuuki",
          "text": "Nem sete."
        },
        {
          "speaker": "Tenebris",
          "text": "Cinco?"
        },
        {
          "speaker": "Tenebris",
          "text": "Sabia."
        },
        {
          "speaker": "Yuuki",
          "text": "Você é irritante."
        },
        {
          "speaker": "Tenebris",
          "text": "Você fala isso bastante."
        },
        {
          "speaker": "Yuuki",
          "text": "Porque você é."
        }
      ]
    },
    {
      "id": "wings-talk",
      "kind": "talk",
      "title": "Uma branca. Outra negra.",
      "x": 2690,
      "y": 850,
      "range": 70,
      "speed": 138,
      "lines": [
        {
          "speaker": "Tenebris",
          "text": "Foi alguém da escola?"
        },
        {
          "speaker": "Yuuki",
          "text": "Não."
        },
        {
          "speaker": "Tenebris",
          "text": "Eu nem falei nada."
        },
        {
          "speaker": "Yuuki",
          "text": "Mas pensou."
        },
        {
          "speaker": "Tenebris",
          "text": "Você não sabe o que eu pensei."
        },
        {
          "speaker": "Yuuki",
          "text": "Sei sim."
        },
        {
          "speaker": "Tenebris",
          "text": "Então fala."
        },
        {
          "speaker": "Yuuki",
          "text": "Você está pensando em bater em alguém."
        },
        {
          "speaker": "Yuuki",
          "text": "Acertei."
